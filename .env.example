# Copy to .env (optional). All values have defaults; no API keys required.
PORT=3000
POLL_INTERVAL_SEC=300
# Comma-separated public XRPL WebSocket endpoints, tried in order
XRPL_WS_URLS=wss://xrplcluster.com,wss://s1.ripple.com,wss://s2.ripple.com
# Spot metal price (USD/oz). Default free keyless API: https://api.gold-api.com/price/{symbol}
# SPOT_API_URL_TEMPLATE=https://api.gold-api.com/price/{symbol}
# SPOT_API_KEY=            # sent as x-access-token header if your provider needs one
# SPOT_STATIC_XAU=4000     # pin a price (offline/demo); overrides the API
# SPOT_STATIC_XAG=50
# SPOT_STATIC_XPT=1400
# Health thresholds
LOW_LIQUIDITY_USD=10000
PEG_WARN_PCT=3
PEG_CRIT_PCT=10
CONCENTRATION_WARN_PCT=50
# DEX mid is only used as a price when bid/ask spread <= this %
MAX_DEX_SPREAD_PCT=20
# Where latest.json / alerts.log live (use a persistent volume in production)
# DATA_DIR=./data
# Required in production (NODE_ENV=production) to enable POST /api/refresh (header x-refresh-token)
# REFRESH_TOKEN=
# Alert stubs (log only for now)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_EMAIL_TO=
# Optional privacy-friendly analytics. When set (e.g. thereservewatch.com) every page loads Plausible's
# cookie-free script for that domain and /privacy describes it. Unset = no analytics script at all.
# PLAUSIBLE_DOMAIN=thereservewatch.com
# Contact address shown on the site and in Organization JSON-LD
# CONTACT_EMAIL=

# Optional: Organization JSON-LD sameAs (official profiles only, comma-separated https URLs). Empty = omitted.
# SAME_AS_URLS=https://x.com/<handle>,https://github.com/<org>
